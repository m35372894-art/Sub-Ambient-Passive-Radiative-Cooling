solid pdrc_cooling_model
  facet normal 0 0 -1
    outer loop
      vertex -2.0 0.0 -2.0
      vertex 2.0 0.0 -2.0
      vertex 2.0 2.0 -2.0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex -2.0 0.0 -2.0
      vertex 2.0 2.0 -2.0
      vertex -2.0 2.0 -2.0
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex -2.0 0.0 2.0
      vertex 2.0 0.0 2.0
      vertex 2.0 2.0 2.0
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex -2.0 0.0 2.0
      vertex 2.0 2.0 2.0
      vertex -2.0 2.0 2.0
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex -2.0 0.0 -2.0
      vertex -2.0 0.0 2.0
      vertex -2.0 2.0 2.0
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex -2.0 0.0 -2.0
      vertex -2.0 2.0 2.0
      vertex -2.0 2.0 -2.0
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 2.0 0.0 -2.0
      vertex 2.0 0.0 2.0
      vertex 2.0 2.0 2.0
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 2.0 0.0 -2.0
      vertex 2.0 2.0 2.0
      vertex 2.0 2.0 -2.0
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex -2.0 2.0 -2.0
      vertex 0.0 3.2 -2.1
      vertex 0.0 3.2 2.1
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex -2.0 2.0 -2.0
      vertex 0.0 3.2 2.1
      vertex -2.0 2.0 2.0
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 2.0 2.0 -2.0
      vertex 0.0 3.2 -2.1
      vertex 0.0 3.2 2.1
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 2.0 2.0 -2.0
      vertex 0.0 3.2 2.1
      vertex 2.0 2.0 2.0
    endloop
  endfacet
endsolid pdrc_cooling_model
